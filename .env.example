# Application identity
APP_NAME=Fullstack Starter
APP_DOMAIN=
NEXT_PUBLIC_APP_NAME=Fullstack Starter
NEXT_PUBLIC_APP_DESCRIPTION=A production-ready full-stack starter.
NEXT_PUBLIC_APP_URL=http://localhost

# Local application addresses
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_AUTH_URL=/api/auth
NEXT_PUBLIC_SOCKET_URL=/
BACKEND_INTERNAL_URL=http://localhost:4000
BACKEND_PORT=4000

# Optional host-port overrides (useful when running multiple cloned projects)
DEV_HTTP_PORT=80
DEV_FRONTEND_PORT=3000
DEV_BACKEND_PORT=4000
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
DEV_SEARCH_PORT=7700
DEV_CLAMAV_PORT=3310
PROD_HTTP_PORT=80

# Core data services
POSTGRES_USER=starter
POSTGRES_PASSWORD=starter-local-password
POSTGRES_DB=starter
DATABASE_URL=postgresql://starter:starter-local-password@localhost:5432/starter
RUN_DATABASE_MIGRATIONS=true
CACHE_URL=redis://localhost:6379
SEARCH_ENGINE_URL=http://localhost:7700
SEARCH_ENGINE_MASTER_KEY=starter_dev_master_key
MEILI_ENV=development
MEILI_NO_ANALYTICS=true

# Core application security
BETTER_AUTH_URL=http://localhost/api/auth
BETTER_AUTH_SECRET=local-development-secret-change-in-production
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Optional social login; the UI enables configured providers automatically
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOWED_PRICE_IDS=

# Optional AWS SES email
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_FROM=Fullstack Starter <noreply@example.com>
SES_CONFIGURATION_SET=

# Optional S3-compatible object storage
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Optional automatic Cloudflare Tunnel and DNS
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
DEV_APP_DOMAIN=
PROD_APP_DOMAIN=
DEV_CLOUDFLARE_TUNNEL_NAME=
PROD_CLOUDFLARE_TUNNEL_NAME=
